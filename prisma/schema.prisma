generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  BLOCKED
}

enum RunTrigger {
  SCHEDULE
  MANUAL
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  timezone    String       @default("Europe/Athens")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  jobs        CronJob[]
  runs        JobRun[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model CronJob {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  description String?    @db.Text
  cronExpr    String
  timezone    String     @default("Europe/Athens")
  enabled     Boolean    @default(true)
  method      HttpMethod @default(GET)
  url         String     @db.VarChar(2048)
  headers     Json?
  body        String?    @db.MediumText
  timeoutMs   Int        @default(30000)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lockedUntil DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs        JobRun[]

  @@index([tenantId, enabled, nextRunAt])
  @@index([enabled, nextRunAt, lockedUntil])
}

model JobRun {
  id           String     @id @default(cuid())
  jobId        String
  tenantId     String
  status       RunStatus  @default(PENDING)
  trigger      RunTrigger @default(SCHEDULE)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  httpStatus   Int?
  durationMs   Int?
  responseBody String?    @db.MediumText
  error        String?    @db.Text
  job          CronJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([jobId, startedAt])
}
