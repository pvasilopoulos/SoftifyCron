generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum JobType {
  HTTP
  HEARTBEAT
  WEBHOOK
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  BLOCKED
}

enum RunTrigger {
  SCHEDULE
  MANUAL
  RETRY
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  timezone    String       @default("Europe/Athens")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  jobs        CronJob[]
  runs        JobRun[]
  groups      JobGroup[]
  secrets     Secret[]
  invites     Invite[]
  roles       TenantRole[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Membership {
  id        String      @id @default(cuid())
  userId    String
  tenantId  String
  role      Role        @default(OWNER)
  roleId    String?
  grants    String      @default("") @db.VarChar(500)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef   TenantRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model TenantRole {
  id          String       @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String       @default("") @db.VarChar(240)
  permissions String       @default("") @db.VarChar(500)
  system      Boolean      @default(false)
  locked      Boolean      @default(false)
  sortOrder   Int          @default(100)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invites     Invite[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model JobGroup {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  color     String    @default("#7dffce")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs      CronJob[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CronJob {
  id                   String     @id @default(cuid())
  tenantId             String
  groupId              String?
  name                 String
  description          String?    @db.Text
  type                 JobType    @default(HTTP)
  tags                 String     @default("") @db.VarChar(500)
  cronExpr             String
  timezone             String     @default("Europe/Athens")
  enabled              Boolean    @default(true)
  method               HttpMethod @default(GET)
  url                  String     @db.VarChar(2048)
  headers              Json?
  body                 String?    @db.MediumText
  timeoutMs            Int        @default(30000)
  retryMax             Int        @default(0)
  retryDelaySec        Int        @default(60)
  notifyUrl            String?    @db.VarChar(2048)
  keepResponse         Boolean    @default(false)
  pauseAfter           Int        @default(0)
  consecutiveFailures  Int        @default(0)
  lastStatus           RunStatus?
  lastRunAt            DateTime?
  nextRunAt            DateTime?
  lockedUntil          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group                JobGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  runs                 JobRun[]

  @@index([tenantId, enabled, nextRunAt])
  @@index([tenantId, groupId])
  @@index([tenantId, type])
  @@index([enabled, nextRunAt, lockedUntil])
}

model JobRun {
  id           String     @id @default(cuid())
  jobId        String
  tenantId     String
  status       RunStatus  @default(PENDING)
  trigger      RunTrigger @default(SCHEDULE)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  httpStatus   Int?
  durationMs   Int?
  responseBody String?    @db.MediumText
  responseCharset String? @db.VarChar(40)
  error        String?    @db.Text
  job          CronJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([jobId, startedAt])
  @@index([tenantId, status])
}

model Secret {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  key       String
  valueEnc  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Invite {
  id         String      @id @default(cuid())
  tenantId   String
  email      String
  role       Role        @default(MEMBER)
  roleId     String?
  tokenHash  String      @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef    TenantRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([roleId])
}
