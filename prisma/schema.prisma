generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum JobType {
  HTTP
  HEARTBEAT
  WEBHOOK
  TCP
  DNS
  TLS
  DOMAIN
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  BLOCKED
}

enum RunTrigger {
  SCHEDULE
  MANUAL
  RETRY
  ONCE
}

model Tenant {
  id                       String           @id @default(cuid())
  name                     String
  slug                     String           @unique
  timezone                 String           @default("Europe/Athens")
  notifyEmail              String?          @db.Text
  smtpHost                 String?          @db.VarChar(255)
  smtpPort                 Int              @default(587)
  smtpSecure               Boolean          @default(false)
  smtpUser                 String?          @db.VarChar(160)
  smtpPassEnc              String?          @db.Text
  smtpFrom                 String?          @db.VarChar(190)
  telegramBotTokenEnc      String?          @db.Text
  telegramChatId           String?          @db.Text
  slackWebhookEnc          String?          @db.Text
  webhookSignEnc           String?          @db.Text
  defaultNotifyEmailOn     String           @default("failure,timeout,blocked,pause,recovery") @db.VarChar(120)
  defaultNotifyTelegramOn  String           @default("failure,timeout,blocked,pause,recovery") @db.VarChar(120)
  defaultNotifyWebhookOn   String           @default("failure,timeout,blocked,pause") @db.VarChar(120)
  defaultNotifySlackOn     String           @default("failure,timeout,blocked,pause,recovery") @db.VarChar(120)
  discordWebhookEnc        String?          @db.Text
  defaultNotifyDiscordOn   String           @default("failure,timeout,blocked,pause,recovery") @db.VarChar(120)
  smsUrl                   String?          @db.VarChar(2048)
  smsUser                  String?          @db.VarChar(160)
  smsPassEnc               String?          @db.Text
  smsFrom                  String?          @db.VarChar(40)
  smsTo                    String?          @db.Text
  defaultNotifySmsOn       String           @default("failure,timeout,blocked,pause,missed,escalate,slo") @db.VarChar(120)
  quietHoursStart          String           @default("") @db.VarChar(5)
  quietHoursEnd            String           @default("") @db.VarChar(5)
  quietHoursAllow          String           @default("failure,timeout,blocked,pause,missed") @db.VarChar(120)
  notifyCooldownSec        Int              @default(300)
  runRetentionDays         Int              @default(30)
  bodyKeepLast             Int              @default(20)
  maxConcurrent            Int              @default(4)
  catchUpMissed            Boolean          @default(false)
  skipGreekHolidays        Boolean          @default(false)
  escalateEmail            String?          @db.Text
  escalateAfter            Int              @default(3)
  statusPageEnabled        Boolean          @default(false)
  statusPageSlug           String?          @unique
  maintEnabled             Boolean          @default(false)
  maintStartWd             Int              @default(5)
  maintStartHm             String           @default("22:00") @db.VarChar(5)
  maintEndWd               Int              @default(1)
  maintEndHm               String           @default("07:00") @db.VarChar(5)
  maintMuteOnly            Boolean          @default(false)
  digestEnabled            Boolean          @default(false)
  digestHour               String           @default("08:00") @db.VarChar(5)
  digestLastDate           String           @default("") @db.VarChar(10)
  oncallEnabled            Boolean          @default(false)
  oncallRoster             String           @default("") @db.VarChar(2000)
  capJobs                  Int              @default(0)
  capRunsMonth             Int              @default(0)
  statusLogoUrl            String?          @db.VarChar(2048)
  statusCustomHost         String?          @unique @db.VarChar(255)
  loginAllowIps            String?          @db.Text
  portalTokenHash          String?          @unique
  portalTokenPrefix        String?          @db.VarChar(16)
  apiEventUrl              String?          @db.VarChar(2048)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  memberships              Membership[]
  jobs                     CronJob[]
  runs                     JobRun[]
  groups                   JobGroup[]
  secrets                  Secret[]
  invites                  Invite[]
  roles                    TenantRole[]
  apiTokens                ApiToken[]
  auditEvents              AuditEvent[]
  deliveries               NotifyDelivery[]
  statusSubscribers        StatusSubscriber[]
  pushSubs                 PushSubscription[]
  incidents                Incident[]
  library                  JobLibrary[]
  notifyTemplates          NotifyTemplate[]
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  platformRole   PlatformRole    @default(USER)
  totpEnabled    Boolean         @default(false)
  totpSecretEnc  String?         @db.Text
  totpRecoveryEnc String?        @db.Text
  sessionEpoch   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  passwordResets PasswordReset[]
  auditEvents    AuditEvent[]
  pushSubs       PushSubscription[]
}

model Membership {
  id        String      @id @default(cuid())
  userId    String
  tenantId  String
  role      Role        @default(OWNER)
  roleId    String?
  grants    String      @default("") @db.VarChar(500)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef   TenantRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model TenantRole {
  id          String       @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String       @default("") @db.VarChar(240)
  permissions String       @default("") @db.VarChar(500)
  system      Boolean      @default(false)
  locked      Boolean      @default(false)
  sortOrder   Int          @default(100)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invites     Invite[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model JobGroup {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  color          String    @default("#7dffce")
  maintEnabled   Boolean   @default(false)
  maintStartWd   Int       @default(5)
  maintStartHm   String    @default("22:00") @db.VarChar(5)
  maintEndWd     Int       @default(1)
  maintEndHm     String    @default("07:00") @db.VarChar(5)
  maintMuteOnly  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs      CronJob[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CronJob {
  id                   String     @id @default(cuid())
  tenantId             String
  groupId              String?
  name                 String
  description          String?    @db.Text
  type                 JobType    @default(HTTP)
  tags                 String     @default("") @db.VarChar(500)
  cronExpr             String
  timezone             String     @default("Europe/Athens")
  enabled              Boolean    @default(true)
  method               HttpMethod @default(GET)
  url                  String     @db.VarChar(2048)
  headers              Json?
  body                 String?    @db.MediumText
  timeoutMs            Int        @default(30000)
  retryMax             Int        @default(0)
  retryDelaySec        Int        @default(60)
  notifyUrl            String?    @db.VarChar(2048)
  notifyEmailOn        String     @default("failure,timeout,blocked,pause,recovery") @db.VarChar(120)
  notifyTelegramOn     String     @default("") @db.VarChar(120)
  notifyWebhookOn      String     @default("failure,timeout,blocked,pause") @db.VarChar(120)
  notifySlackOn        String     @default("") @db.VarChar(120)
  notifyDiscordOn      String     @default("") @db.VarChar(120)
  notifySmsOn          String     @default("") @db.VarChar(120)
  hookTokenHash        String?    @unique
  hookTokenPrefix      String?    @db.VarChar(16)
  hookHmac             String     @default("") @db.VarChar(16)
  telegramTemplateId   String?
  telegramNote         String     @default("") @db.VarChar(500)
  assigneeEmail        String     @default("") @db.VarChar(190)
  configLocked         Boolean    @default(false)
  authUrl              String     @default("") @db.VarChar(2048)
  authBody             String     @default("") @db.Text
  extraHosts           String     @default("") @db.Text
  assertFinalUrl       String     @default("") @db.VarChar(2048)
  assertJsonSchema     String     @default("") @db.Text
  goldenBody           String     @default("") @db.LongText
  flapScore            Int        @default(0)
  keepResponse         Boolean    @default(false)
  responseBoard        Boolean    @default(false)
  pauseAfter           Int        @default(0)
  snoozeUntil          DateTime?
  followUpJobId        String?
  dependsOnJobId       String?
  assertStatus         Int        @default(0)
  assertJsonPath       String     @default("") @db.VarChar(240)
  assertEquals         String     @default("") @db.VarChar(500)
  assertContains       String     @default("") @db.VarChar(500)
  slowAfterMs          Int        @default(0)
  skipHolidays         Boolean    @default(false)
  skipWeekends         Boolean    @default(false)
  activeHoursStart     String     @default("") @db.VarChar(5)
  activeHoursEnd       String     @default("") @db.VarChar(5)
  notes                String?    @db.Text
  ackedAt              DateTime?
  ackedBy              String?    @db.VarChar(190)
  ackNote              String?    @db.VarChar(500)
  eventMutes           Json?
  gridViews            Json?
  gridWatches          Json?
  onceAt               DateTime?
  sloFailPerDay        Int        @default(0)
  consecutiveFailures  Int        @default(0)
  lastStatus           RunStatus?
  lastRunAt            DateTime?
  lastHeartbeatAt      DateTime?
  nextRunAt            DateTime?
  lockedUntil          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group                JobGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  telegramTemplate     NotifyTemplate? @relation(fields: [telegramTemplateId], references: [id], onDelete: SetNull)
  runs                 JobRun[]
  revisions            JobRevision[]
  deliveries           NotifyDelivery[]
  incidents            Incident[]

  @@index([telegramTemplateId])

  @@index([tenantId, enabled, nextRunAt])
  @@index([tenantId, groupId])
  @@index([tenantId, type])
  @@index([enabled, nextRunAt, lockedUntil])
  @@index([onceAt])
}

model JobRun {
  id           String     @id @default(cuid())
  jobId        String
  tenantId     String
  status       RunStatus  @default(PENDING)
  trigger      RunTrigger @default(SCHEDULE)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  httpStatus   Int?
  durationMs   Int?
  responseBody    String?    @db.LongText
  responseCharset String?    @db.VarChar(40)
  error        String?    @db.Text
  comment      String?    @db.VarChar(500)
  dnsMs        Int?
  connectMs    Int?
  ttfbMs       Int?
  finalUrl     String?    @db.VarChar(2048)
  silent       Boolean    @default(false)
  job          CronJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([jobId, startedAt])
  @@index([tenantId, status])
}

model Incident {
  id            String    @id @default(cuid())
  tenantId      String
  jobId         String
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openedByRunId String    @default("")
  closedByRunId String    @default("")
  assigneeEmail String    @default("") @db.VarChar(190)
  note          String    @default("") @db.Text
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job           CronJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, closedAt])
  @@index([jobId, closedAt])
}

model JobLibrary {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String   @default("")
  snapshot    Json
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NotifyTemplate {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs      CronJob[]

  @@index([tenantId])
}

model Secret {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  key       String
  valueEnc  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Invite {
  id         String      @id @default(cuid())
  tenantId   String
  email      String
  role       Role        @default(MEMBER)
  roleId     String?
  tokenHash  String      @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef    TenantRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([roleId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String    @default("") @db.VarChar(240)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  actorId   String?
  action    String
  target    String?
  meta      String?  @db.Text
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

model NotifyDelivery {
  id        String   @id @default(cuid())
  tenantId  String
  jobId     String
  runId     String?
  channel   String   @db.VarChar(20)
  event     String   @db.VarChar(80)
  status    String   @db.VarChar(20)
  detail    String?  @db.Text
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job       CronJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([jobId, createdAt])
  @@index([jobId, channel, createdAt])
}

model StatusSubscriber {
  id            String    @id @default(cuid())
  tenantId      String
  email         String    @db.VarChar(190)
  token         String    @unique
  confirmedAt   DateTime?
  lastAlertDate String    @default("") @db.VarChar(10)
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model JobRevision {
  id        String   @id @default(cuid())
  jobId     String
  tenantId  String
  actor     String   @db.VarChar(190)
  snapshot  Json
  createdAt DateTime @default(now())
  job       CronJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([tenantId, createdAt])
}

model WorkerHeartbeat {
  id          String   @id
  tickedAt    DateTime
  hostname    String?
  jobsClaimed Int      @default(0)
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  endpoint     String   @db.Text
  endpointHash String   @db.VarChar(64)
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, endpointHash])
  @@index([tenantId])
}

model AppMeta {
  id              String @id
  vapidPublic     String @db.Text
  vapidPrivateEnc String @db.Text
}
